# Vagar configuration — copy to .env and fill in your values.
# .env is git-ignored. Never commit personal details or secrets.

# --- who Vagar serves ---
# First name Vagar uses for you in conversation and transcripts.
VAGAR_USER_NAME=friend
# Formal address for Alfred-style greetings ("Good day, sir.").
VAGAR_USER_FORMAL_NAME=sir
# One or two sentences about you, used in Vagar's system prompt.
# Example: "A CS student in Austin, TX. Building a home lab. Prefers short answers."
VAGAR_USER_BIO=They built you. They prefer clear, plain language and direct answers.
# Vagar's own name (changeable by voice with the change_name tool).
VAGAR_NAME=Vagar

# --- data ---
# Directory for runtime files (memory, quests, reminders, sessions).
# Defaults to the project root.
#VAGAR_DATA_DIR=/path/to/vagar-data

# --- voice (Kokoro TTS, local ONNX) ---
#VAGAR_KOKORO_MODEL=/path/to/model_q4.onnx
#VAGAR_KOKORO_VOICES=/path/to/voices.npz
VAGAR_KOKORO_VOICE=bm_lewis
VAGAR_KOKORO_SPEED=1.0

# --- models (Ollama, local) ---
VAGAR_OLLAMA_URL=http://localhost:11434/v1
VAGAR_OLLAMA_MODEL=qwen2.5:0.5b
VAGAR_OLLAMA_DEEP_MODEL=qwen2.5:3b
VAGAR_VISION_MODEL=moondream

# --- speech recognition ---
VAGAR_WHISPER_MODEL=base.en
VAGAR_WHISPER_LANG=en

# --- LiveKit ---
VAGAR_LIVEKIT_URL=ws://127.0.0.1:7880

# --- optional project directories ---
#VAGAR_BOOK_DIR=/path/to/book_images

# --- weather (morning briefing) ---
# City for wttr.in, e.g. "Austin,Texas". Leave blank to skip weather.
#VAGAR_WEATHER_LOCATION=Austin,Texas
# Coordinates for the Open-Meteo fallback (decimal degrees).
#VAGAR_WEATHER_LAT=30.27
#VAGAR_WEATHER_LON=-97.74
